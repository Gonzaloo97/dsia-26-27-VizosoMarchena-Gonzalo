# Copiar a .env es OPCIONAL para mock. No subir claves a Git.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Plantilla del enunciado: reservado para una futura alternativa Hugging Face.
# La demo usa mock; OpenAI es el proveedor real implementado.
# HF_TOKEN no activa un adaptador Hugging Face.
HF_TOKEN=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
